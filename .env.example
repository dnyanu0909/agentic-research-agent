# Environment Configuration
# Copy this file to .env and fill in your values
# cp .env.example .env

# ─── Ollama Model Settings ─────────────────────────────────────────────────────
# The local model to use. Must be pulled via: ollama pull <model>
# Recommended: mistral | llama3.1 | qwen2.5:7b | phi3
OLLAMA_MODEL=mistral

# Ollama server URL (default works for local installs; change for remote Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# ─── Agent Settings ────────────────────────────────────────────────────────────
# Maximum number of think/act steps before the agent is forced to write a report
# Increase for complex multi-part goals; decrease for faster demos
MAX_STEPS=14
